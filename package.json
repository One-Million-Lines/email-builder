{
  "name": "@one-million-lines/email-builder",
  "version": "0.16.0",
  "description": "Embeddable visual email builder (React + vanilla JS) that composes modular marketing emails from a JSON model and exports table-based HTML.",
  "type": "module",
  "license": "MIT",
  "author": "Alex Rada (https://linkedin.com/in/alexrada)",
  "homepage": "https://github.com/one-million-lines/email-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/one-million-lines/email-builder.git"
  },
  "bugs": {
    "url": "https://github.com/one-million-lines/email-builder/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "email-builder",
    "email-editor",
    "email-template",
    "drag-and-drop",
    "react",
    "html-email",
    "newsletter",
    "marketing",
    "no-code",
    "visual-editor"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css",
    "**/templates/**"
  ],
  "main": "./dist/email-builder.cjs",
  "module": "./dist/email-builder.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/email-builder.js",
      "require": "./dist/email-builder.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "dev:mock": "node dev/mock-server.mjs",
    "build": "vite build --config vite.lib.config.ts",
    "build:demo": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build",
    "validate:pack": "npm run build && npm pack --dry-run",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "generate:previews": "npm run build && node scripts/generate-previews.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.74.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  }
}
